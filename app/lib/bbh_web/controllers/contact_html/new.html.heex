<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  <div class="mx-auto max-w-xl">
    <h1 class="mb-6 text-3xl font-semibold">Kontakt</h1>

    <form method="post" action={~p"/kontakt"} class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="form_ts" value={@form_token} />

      <div
        aria-hidden="true"
        style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden"
      >
        <label for="website">Bitte dieses Feld leer lassen</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div :if={@recipients != []}>
        <label for="an" class="mb-1 block text-sm font-medium">An</label>
        <select id="an" name="an" class="w-full rounded border border-base-300 px-3 py-2">
          <option
            :for={{label, key} <- @recipients}
            value={key}
            selected={value_for(@params, "an") == key}
          >
            {label}
          </option>
        </select>
      </div>

      <div>
        <label for="name" class="mb-1 block text-sm font-medium">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          value={value_for(@params, "name")}
          class="w-full rounded border border-base-300 px-3 py-2"
        />
        <p :if={error_for(@errors, :name)} class="mt-1 text-sm text-error">
          {error_for(@errors, :name)}
        </p>
      </div>

      <div>
        <label for="email" class="mb-1 block text-sm font-medium">E-Mail</label>
        <input
          type="email"
          id="email"
          name="email"
          value={value_for(@params, "email")}
          class="w-full rounded border border-base-300 px-3 py-2"
        />
        <p :if={error_for(@errors, :email)} class="mt-1 text-sm text-error">
          {error_for(@errors, :email)}
        </p>
      </div>

      <div>
        <label for="message" class="mb-1 block text-sm font-medium">Nachricht</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          class="w-full rounded border border-base-300 px-3 py-2"
        >{value_for(@params, "message")}</textarea>
        <p :if={error_for(@errors, :message)} class="mt-1 text-sm text-error">
          {error_for(@errors, :message)}
        </p>
      </div>

      <div :if={@altcha}>
        <altcha-widget challengejson={Jason.encode!(@altcha)} auto="onload"></altcha-widget>
      </div>

      <%!-- A notice, not a checkbox: answering a contact request needs no consent
            (Art. 6(1)(f) GDPR), and a mandatory "I agree" would not be freely given. --%>
      <p id="privacy-notice" class="text-sm text-muted">
        Informationen zur Verarbeitung Ihrer Daten finden Sie in unserer <a
          href={~p"/datenschutz"}
          class="text-primary hover:underline"
        >Datenschutzerklärung</a>.
      </p>

      <button
        type="submit"
        class="rounded bg-primary px-4 py-2 font-medium text-primary-content hover:opacity-90"
      >
        Absenden
      </button>
    </form>
  </div>
</Layouts.app>
