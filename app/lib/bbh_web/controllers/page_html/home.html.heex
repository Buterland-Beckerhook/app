<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  <%!-- The hero was dropped with the redesign; keep an h1 for the document outline. --%>
  <h1 class="sr-only">Schützenverein Buterland-Beckerhook e.V.</h1>

  <%!-- ===== HINWEIS (admin-editable notice) ===== --%>
  <div
    :if={@settings.home_notice_enabled and @settings.home_notice_text not in [nil, ""]}
    class="mt-2 flex items-start gap-3 rounded-2xl border border-primary/25 bg-primary/5 px-5 py-4 text-primary md:mt-6"
    role="status"
  >
    <.icon name="hero-information-circle" class="mt-0.5 size-6 shrink-0" />
    <div class="prose prose-sm max-w-none text-base-content">
      {BbhWeb.Format.sanitized_html(@settings.home_notice_text)}
    </div>
  </div>

  <%!-- ===== NÄCHSTER TERMIN (highlight banner) ===== --%>
  <section :if={@next_event} id="termine" class="mt-2 scroll-mt-24 md:mt-6">
    <div class="relative overflow-hidden rounded-[22px] bg-[linear-gradient(120deg,#0f4d2c_0%,#15693c_58%,#1c7d47_100%)] text-white shadow-[0_30px_60px_-28px_rgba(15,77,44,0.6)]">
      <img
        src={~p"/images/logo.svg"}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 right-5 hidden h-75 -translate-y-1/2 opacity-10 md:block"
      />
      <div class="relative grid items-center gap-8 p-8 md:grid-cols-[auto_1fr_auto] md:p-11">
        <%!-- date badge --%>
        <div class="mx-auto flex size-32 flex-col items-center justify-center rounded-2xl border border-white/25 bg-white/10 md:mx-0">
          <span class="text-xs font-bold tracking-widest uppercase opacity-85">
            {month_abbr(@next_event.starts_at)}
          </span>
          <span class="font-logo text-5xl leading-none font-bold">
            {@next_event.starts_at.day}
          </span>
          <span class="text-xs font-semibold opacity-85">{@next_event.starts_at.year}</span>
        </div>
        <%!-- text --%>
        <div class="min-w-0 text-center md:text-left">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-bold tracking-wider uppercase">
            ★ Nächster Termin
          </span>
          <h2 class="font-logo mt-3.5 text-3xl font-bold md:text-4xl">{@next_event.title}</h2>
          <p class="mt-1.5 text-base leading-relaxed opacity-90">
            {de_range(@next_event.starts_at, @next_event.ends_at, @next_event.all_day)}
            <span :if={@next_event.location}>· {@next_event.location.name}</span>
          </p>
          <%!-- a festival's running or next programme item --%>
          <a
            :if={@next_child}
            id="next-programme-item"
            href={BbhWeb.EventPaths.path(@next_child)}
            class="mt-4 block rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-left transition-colors hover:bg-white/15"
          >
            <span class="text-[11px] font-bold tracking-widest uppercase opacity-80">
              {if BbhWeb.EventHTML.item_state(@next_child, @now) == :running,
                do: "Jetzt",
                else: "Als Nächstes"}
            </span>
            <span class="block text-lg leading-snug font-semibold">
              {@next_child.title}
              <span
                :if={@next_child.status == "canceled"}
                class="ml-1 rounded bg-white/20 px-1.5 py-0.5 text-xs font-bold uppercase"
              >
                Abgesagt
              </span>
            </span>
            <span class="text-sm opacity-85">
              {BbhWeb.EventHTML.item_when(@next_child)}<span :if={@next_child.location}> · {@next_child.location.name}</span>
            </span>
          </a>
          <div class="mt-5 flex flex-wrap justify-center gap-3.5 md:justify-start">
            <a
              href={BbhWeb.EventPaths.path(@next_event)}
              class="rounded-full bg-white px-5 py-2.5 font-bold text-[#0f4d2c] transition-shadow hover:shadow-md"
            >
              Zum Termin
            </a>
            <a
              href={~p"/termine"}
              class="rounded-full border border-white/30 bg-white/10 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-white/20"
            >
              Alle Termine
            </a>
          </div>
        </div>
        <%!-- countdown --%>
        <div :if={@countdown} class="flex flex-col items-center gap-3">
          <span class="text-xs font-bold tracking-widest uppercase opacity-80">
            {@countdown.label}
          </span>
          <div
            id="bb-countdown"
            class="flex gap-2.5"
            data-countdown-to={countdown_target(@countdown.at)}
            data-countdown-now={countdown_target(@now)}
          >
            <div
              :for={
                {label, unit} <- [
                  {"Tage", "days"},
                  {"Std", "hours"},
                  {"Min", "minutes"},
                  {"Sek", "seconds"}
                ]
              }
              class="flex min-w-14 flex-col items-center rounded-xl border border-white/20 bg-white/10 px-1.5 py-3"
            >
              <span class="font-logo text-3xl leading-none font-bold tabular-nums" data-cd={unit}>
                –
              </span>
              <span class="mt-1.5 text-[11px] font-semibold tracking-wide uppercase opacity-80">
                {label}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== AKTUELLES ===== --%>
  <section :if={@articles != []} id="aktuelles" class="mt-16 scroll-mt-24">
    <div class="mb-7 flex items-baseline justify-between gap-5">
      <div>
        <span class="text-[13px] font-semibold tracking-[0.12em] text-primary uppercase">
          Vom Verein
        </span>
        <h2 class="font-logo text-4xl font-bold">Aktuelles</h2>
      </div>
      <a href={~p"/aktuell"} class="text-sm font-semibold text-primary hover:underline">
        Alle Nachrichten →
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <.article_card :for={article <- @articles} article={article} />
    </div>
  </section>

  <%!-- ===== THRON ===== --%>
  <section :if={@thrones != []} id="thron" class="mt-16 scroll-mt-24">
    <div class="mb-9 max-w-2xl">
      <span class="text-[13px] font-semibold tracking-[0.12em] text-primary uppercase">
        Seit 1909
      </span>
      <h2 class="font-logo mt-1.5 text-4xl font-bold">Throne</h2>
      <p class="mt-3.5 text-base leading-relaxed text-muted">
        Das amtierende Königspaar regiert im Buterland-Beckerhook, an seiner Seite Kaiser
        und Stadtkaiser. Entdecken Sie unsere Throne und ihre Geschichte bis zurück ins
        Gründungsjahr.
      </p>
      <a
        href={~p"/thron"}
        class="mt-5 inline-flex items-center gap-2 rounded-full border border-base-300 bg-card px-5 py-3 font-semibold text-primary transition-colors hover:border-primary"
      >
        Alle Throne seit 1909 →
      </a>
    </div>

    <div class="flex flex-col gap-8">
      <%!-- All picture tiles share one height (md:min-h) and stretch (items-stretch) to the
           throne table beside them — the Stadtkaiser too (only the Kaiser couple). --%>
      <div
        :for={throne <- @thrones}
        class="grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:items-stretch"
      >
        <% pic = throne_picture(throne) %>
        <% article_path = throne_article_path(throne) %>
        <%!-- Picture and name link to the throne article — except for „Nur Thron-Anzeige“
             or an article not yet published (throne_article_path/1 → nil). Without an
             href the <a> is only a placeholder: no link, not focusable. --%>
        <a
          href={article_path}
          tabindex={article_path && "-1"}
          aria-hidden={article_path && "true"}
          class={[
            "group block min-h-56 overflow-hidden rounded-[20px] border border-base-300 bg-card md:min-h-[24rem]",
            article_path && "transition-colors hover:border-primary"
          ]}
        >
          <img
            :if={pic}
            src={media_url(pic, width: 960, height: 720)}
            srcset={media_srcset(pic, width: 960, height: 720)}
            sizes="(min-width: 48rem) 36rem, 100vw"
            alt={image_alt(pic)}
            loading="lazy"
            class={[
              "h-full w-full object-cover",
              article_path && "transition-transform duration-300 group-hover:scale-[1.02]"
            ]}
          />
          <div :if={!pic} class="flex h-full items-center justify-center bg-tag">
            <img src={~p"/images/logo.svg"} alt="" class="h-24 w-auto opacity-30" />
          </div>
        </a>
        <div class="flex flex-col overflow-hidden rounded-[20px] border border-base-300 bg-card">
          <div class="flex flex-wrap items-center justify-between gap-2.5 bg-[linear-gradient(120deg,#0f4d2c,#1c7d47)] px-7 py-5">
            <a
              href={article_path}
              class={[
                "font-logo text-2xl font-bold text-white",
                article_path && "hover:underline"
              ]}
            >
              {throne_name(throne)}
            </a>
            <span class="font-logo ml-auto text-xl font-bold whitespace-nowrap text-[#eafaef]">
              {throne_years(throne)}
            </span>
          </div>
          <div class="px-7 pt-1 pb-3">
            <.throne_table throne={throne} show_caption={false} />
            <a
              :if={article_path}
              href={article_path}
              class="mt-2 mb-2 inline-block text-sm font-semibold text-primary hover:underline"
            >
              Zum Artikel →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
