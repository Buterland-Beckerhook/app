<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  <h1 class="mb-6 text-3xl font-semibold">{@heading}</h1>

  <p :if={@result.entries == []} class="text-muted">
    Es sind noch keine Throne erfasst.
  </p>

  <div :for={throne <- @result.entries} class="mx-auto max-w-3xl">
    <h2 class="mb-6 flex flex-wrap items-baseline justify-between gap-x-3 text-3xl font-semibold">
      <span>{throne_name(throne)}</span>
      <span class="text-xl font-normal text-muted">{throne_years(throne)}</span>
    </h2>

    <% pic = throne_picture(throne) %>
    <% article_path = throne_article_path(throne) %>
    <figure :if={pic} class="mb-6">
      <%!-- Das Bild führt zum Thron-Artikel, außer bei „Nur Thron-Anzeige“. Der Link ist
           eine Dublette von „Zum Artikel“ und bleibt deshalb aus Tab-Reihenfolge und
           Screenreader heraus. --%>
      <a
        href={article_path}
        tabindex={article_path && "-1"}
        aria-hidden={article_path && "true"}
        class="block overflow-hidden rounded-lg"
      >
        <img
          src={media_url(pic, width: 1024)}
          alt={image_alt(pic)}
          class={[
            "w-full rounded-lg object-cover",
            article_path && "transition-transform duration-300 hover:scale-[1.02]"
          ]}
        />
      </a>
      <.image_credit caption={image_caption(pic)} copyright={image_copyright(pic)} />
    </figure>
    <div class="rounded-lg border border-base-300 p-4">
      <.throne_table throne={throne} show_caption={false} />
      <a
        :if={article_path}
        href={article_path}
        class="mt-4 inline-block text-sm text-primary hover:underline"
      >
        Zum Artikel
      </a>
    </div>
  </div>

  <.throne_pager page={@result.page} nav={@nav} base_path={@base_path} />
</Layouts.app>
