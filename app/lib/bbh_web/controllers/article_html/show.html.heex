<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  <article class="mx-auto max-w-3xl">
    <div
      :if={assigns[:preview]}
      class="mb-4 rounded-box border border-warning bg-warning/10 px-4 py-2 text-sm"
    >
      <span class="font-medium">Vorschau</span>
      — dieser Artikel ist derzeit nicht öffentlich sichtbar.<span :if={article_status_label(@article)}>
        {article_status_label(@article)}.</span>
    </div>

    <div class="flex items-center justify-between gap-3">
      <a href={~p"/aktuell"} class="text-sm text-primary hover:underline">
        &larr; Zurück zu Aktuelles
      </a>
      <.edit_link
        :if={BbhWeb.Authz.can_access_section?(@current_scope && @current_scope.user, :articles)}
        href={~p"/admin/artikel/#{@article.id}/bearbeiten"}
      />
    </div>

    <header class="mt-4">
      <h1 class="text-3xl font-semibold">{@article.title}</h1>
      <p :if={@article.subtitle} class="mt-1 text-lg text-muted">
        {@article.subtitle}
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 text-sm text-muted">
        <time>{de_date(@article.date_published)}</time>
        <span :if={@article.author}>von {@article.author}</span>
      </div>
      <div :if={@article.tags != []} class="mt-3 flex flex-wrap gap-1">
        <span
          :for={tag <- @article.tags}
          class="rounded bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary"
        >
          {tag}
        </span>
      </div>
    </header>

    <% hero = article_hero(@article) %>
    <figure :if={hero} class="mt-6">
      <button
        type="button"
        data-lightbox-src={media_url(hero.media, width: 1600)}
        data-lightbox-alt={image_alt(hero)}
        data-lightbox-caption={image_caption(hero)}
        data-lightbox-copyright={copyright_label(image_copyright(hero))}
        data-lightbox-group={"article-#{@article.id}"}
        class="block w-full cursor-zoom-in"
        aria-label="Bild vergrößern"
      >
        <.hero_image article={@article} width={1024} class="w-full rounded-lg" />
      </button>
      <.image_credit caption={image_caption(hero)} copyright={image_copyright(hero)} />
    </figure>
    <.hero_image :if={!hero} article={@article} width={1024} class="mt-6 w-full rounded-lg" />

    <div :if={@article.body} class="prose mt-6 max-w-none dark:prose-invert">
      {render_richtext(@article.body)}
    </div>

    <section
      :if={@article.throne}
      class="mt-8 rounded-lg border border-base-300 p-4"
    >
      <.throne_table throne={@article.throne} />
    </section>

    <% gallery = Enum.reject(@article.images, &(hero && &1.id == hero.id)) %>
    <section :if={gallery != []} class="mt-8">
      <h2 class="mb-3 text-xl font-semibold">Bilder</h2>
      <%!-- Thumbnails stay bare; caption and copyright appear on enlarging. --%>
      <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
        <button
          :for={img <- gallery}
          type="button"
          data-lightbox-src={media_url(img.media, width: 1600)}
          data-lightbox-alt={image_alt(img)}
          data-lightbox-caption={image_caption(img)}
          data-lightbox-copyright={copyright_label(image_copyright(img))}
          data-lightbox-group={"article-#{@article.id}"}
          class="group block cursor-zoom-in"
          aria-label="Bild vergrößern"
        >
          <img
            src={media_url(img.media, width: 400, height: 400)}
            alt={image_alt(img)}
            loading="lazy"
            class="aspect-square w-full rounded object-cover transition group-hover:opacity-90"
          />
        </button>
      </div>
    </section>
  </article>
</Layouts.app>
