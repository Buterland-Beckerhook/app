<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  {event_jsonld(@event)}
  <article class="mx-auto max-w-3xl">
    <div class="flex items-center justify-between gap-3">
      <p class="text-sm text-muted">
        Teil von:
        <a
          href={BbhWeb.EventPaths.path(@festival) <> "#programm"}
          class="text-primary hover:underline"
        >
          {@festival.title}
        </a>
      </p>
      <.edit_link
        :if={BbhWeb.Authz.can_edit_event?(@current_scope && @current_scope.user, @event)}
        href={~p"/admin/termine/#{@event.id}/bearbeiten"}
      />
    </div>

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold">{@event.title}</h1>
        <span
          :if={item_state(@event) == :running}
          class="rounded bg-primary px-2 py-0.5 text-sm font-bold text-primary-content uppercase"
        >
          Jetzt
        </span>
        <span
          :if={@event.status == "canceled"}
          class="rounded bg-error/10 px-2 py-0.5 text-sm font-medium text-error"
        >
          Abgesagt
        </span>
      </div>
      <p class="mt-2 text-muted">
        {de_date(@event.starts_at)}, {item_time(@event)}
      </p>
      <p :if={@event.status == "canceled" && @event.cancel_reason} class="mt-1 text-sm text-error">
        {@event.cancel_reason}
      </p>
    </header>

    <% location = @event.location || @festival.location %>
    <div :if={location} class="mt-4 rounded-lg border border-base-300 p-4">
      <p class="font-medium">{location.name}</p>
      <p :if={location.street} class="text-sm text-muted">
        {location.street}
        <span :if={location.city}>, {location.zip} {location.city}</span>
      </p>
      <a
        :if={location.maps_url}
        href={location.maps_url}
        target="_blank"
        rel="noopener"
        class="mt-2 inline-block text-sm text-primary hover:underline"
      >
        Karte anzeigen
      </a>
    </div>

    <div :if={@event.body} class="prose mt-6 max-w-none dark:prose-invert">
      {render_richtext(@event.body)}
    </div>

    <nav
      :if={@prev || @next}
      aria-label="Programm"
      class="mt-10 grid gap-3 sm:grid-cols-2"
    >
      <a
        :if={@prev}
        href={BbhWeb.EventPaths.path(@prev)}
        class="rounded-lg border border-base-300 bg-card p-4 transition-shadow hover:shadow-md"
      >
        <span class="text-xs font-semibold tracking-wide text-muted uppercase">
          &larr; Davor
        </span>
        <span class="mt-1 block font-semibold">{@prev.title}</span>
        <span class="text-sm text-muted">{item_when(@prev)}</span>
      </a>
      <a
        :if={@next}
        href={BbhWeb.EventPaths.path(@next)}
        class="rounded-lg border border-base-300 bg-card p-4 text-right transition-shadow hover:shadow-md sm:col-start-2"
      >
        <span class="text-xs font-semibold tracking-wide text-muted uppercase">
          Danach &rarr;
        </span>
        <span class="mt-1 block font-semibold">{@next.title}</span>
        <span class="text-sm text-muted">{item_when(@next)}</span>
      </a>
    </nav>

    <div :if={@event.enable_ical} class="mt-8">
      <a
        href={BbhWeb.EventPaths.path(@event) <> "/event.ics"}
        class="text-sm text-primary hover:underline"
      >
        Zum Kalender hinzufügen (.ics)
      </a>
    </div>
  </article>
</Layouts.app>
