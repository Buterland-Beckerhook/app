<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  {event_jsonld(@event)}
  <article class="mx-auto max-w-3xl">
    <div class="flex items-center justify-between gap-3">
      <a href={~p"/termine"} class="text-sm text-primary hover:underline">
        &larr; Zurück zu Termine
      </a>
      <.edit_link
        :if={BbhWeb.Authz.can_edit_event?(@current_scope && @current_scope.user, @event)}
        href={~p"/admin/termine/#{@event.id}/bearbeiten"}
      />
    </div>

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold">{@event.title}</h1>
        <span
          :if={@event.status == "canceled"}
          class="rounded bg-error/10 px-2 py-0.5 text-sm font-medium text-error"
        >
          Abgesagt
        </span>
      </div>
      <p class="mt-2 text-muted">
        {de_range(@event.starts_at, @event.ends_at, @event.all_day)}
      </p>
      <p :if={@event.status == "canceled" && @event.cancel_reason} class="mt-1 text-sm text-error">
        {@event.cancel_reason}
      </p>
    </header>

    <div
      :if={@event.location}
      class="mt-4 rounded-lg border border-base-300 p-4"
    >
      <p class="font-medium">{@event.location.name}</p>
      <p :if={@event.location.street} class="text-sm text-muted">
        {@event.location.street}
        <span :if={@event.location.city}>, {@event.location.zip} {@event.location.city}</span>
      </p>
      <a
        :if={@event.location.maps_url}
        href={@event.location.maps_url}
        target="_blank"
        rel="noopener"
        class="mt-2 inline-block text-sm text-primary hover:underline"
      >
        Karte anzeigen
      </a>
    </div>

    <div :if={@event.body} class="prose mt-6 max-w-none dark:prose-invert">
      {render_richtext(@event.body)}
    </div>

    <section :if={@event.children != []} id="programm" class="mt-10">
      <h2 class="font-logo text-2xl font-bold text-primary">Festprogramm</h2>
      <div :for={{day, items} <- day_groups(@event.children)} class="mt-6">
        <h3 class="border-b border-base-300 pb-2 text-lg font-bold">{day}</h3>
        <ol>
          <li
            :for={item <- items}
            id={item.slug}
            class={[
              "grid scroll-mt-24 grid-cols-[7.5rem_1fr] gap-x-4 border-b border-base-300/60 py-3 last:border-b-0 sm:grid-cols-[8.5rem_1fr_auto]",
              item_state(item) == :past && "opacity-55",
              item_state(item) == :running &&
                "-mx-3 rounded-xl border-b-0 bg-primary/8 px-3 ring-1 ring-primary/30"
            ]}
          >
            <div class="pt-0.5 text-sm font-semibold text-primary tabular-nums">
              {item_time(item)}
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <a
                  :if={BbhWeb.EventPaths.child_pages?()}
                  href={BbhWeb.EventPaths.path(item)}
                  class="font-semibold hover:text-primary hover:underline"
                >
                  {item.title}
                </a>
                <span :if={!BbhWeb.EventPaths.child_pages?()} class="font-semibold">
                  {item.title}
                </span>
                <span
                  :if={item_state(item) == :running}
                  class="rounded bg-primary px-2 py-0.5 text-xs font-bold text-primary-content uppercase"
                >
                  Jetzt
                </span>
                <span
                  :if={item.status == "canceled"}
                  class="rounded bg-error/10 px-2 py-0.5 text-xs font-medium text-error"
                >
                  Abgesagt
                </span>
              </div>
              <p :if={item.status == "canceled" && item.cancel_reason} class="text-sm text-error">
                {item.cancel_reason}
              </p>
              <p :if={loc = item_location(item, @event)} class="text-sm text-muted sm:hidden">
                {loc.name}
              </p>
              <details
                :if={item.body && !BbhWeb.EventPaths.child_pages?()}
                class="group mt-1 text-sm"
              >
                <summary class="cursor-pointer text-primary hover:underline">
                  Mehr erfahren
                </summary>
                <div class="prose prose-sm mt-2 max-w-none dark:prose-invert">
                  {render_richtext(item.body)}
                </div>
              </details>
            </div>
            <div
              :if={loc = item_location(item, @event)}
              class="hidden pt-0.5 text-right text-sm text-muted sm:block"
            >
              {loc.name}
            </div>
          </li>
        </ol>
      </div>
    </section>

    <div :if={@event.enable_ical} class="mt-8">
      <a
        href={BbhWeb.EventPaths.path(@event) <> "/event.ics"}
        class="text-sm text-primary hover:underline"
      >
        {if @event.children != [],
          do: "Fest und Programm zum Kalender hinzufügen (.ics)",
          else: "Zum Kalender hinzufügen (.ics)"}
      </a>
    </div>
  </article>
</Layouts.app>
