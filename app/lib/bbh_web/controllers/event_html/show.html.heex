<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  {event_jsonld(@event)}
  <article class="mx-auto max-w-3xl">
    <div class="flex items-center justify-between gap-3">
      <a href={~p"/termine"} class="text-sm text-primary hover:underline">
        &larr; Zurück zu Termine
      </a>
      <.edit_link
        :if={BbhWeb.Authz.can_edit_event?(@current_scope && @current_scope.user, @event)}
        href={~p"/admin/termine/#{@event.id}/bearbeiten"}
      />
    </div>

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold">{@event.title}</h1>
        <span
          :if={@event.status == "canceled"}
          class="rounded bg-error/10 px-2 py-0.5 text-sm font-medium text-error"
        >
          Abgesagt
        </span>
      </div>
      <p class="mt-2 text-muted">
        {de_range(@event.starts_at, @event.ends_at, @event.all_day)}
      </p>
      <p :if={@event.status == "canceled" && @event.cancel_reason} class="mt-1 text-sm text-error">
        {@event.cancel_reason}
      </p>
    </header>

    <div
      :if={@event.location}
      class="mt-4 rounded-lg border border-base-300 p-4"
    >
      <p class="font-medium">{@event.location.name}</p>
      <p :if={@event.location.street} class="text-sm text-muted">
        {@event.location.street}
        <span :if={@event.location.city}>, {@event.location.zip} {@event.location.city}</span>
      </p>
      <p :if={osm_url(@event.location)} class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <a
          href={osm_url(@event.location)}
          target="_blank"
          rel="noopener"
          class="text-primary hover:underline"
        >
          Auf OpenStreetMap ansehen
        </a>
        <a
          href={osm_route_url(@event.location)}
          target="_blank"
          rel="noopener"
          class="text-primary hover:underline"
        >
          Route planen
        </a>
      </p>
    </div>

    <div :if={@event.body} class="prose mt-6 max-w-none dark:prose-invert">
      {render_richtext(@event.body)}
    </div>

    <section :if={@event.children != []} id="programm" class="mt-10">
      <h2 class="font-logo text-2xl font-bold text-primary">Festprogramm</h2>
      <.programme festival={@event} />
    </section>

    <div :if={@event.enable_ical} class="mt-8 text-sm">
      <.calendar_link event={@event} />
    </div>

    <.location_map
      :if={@event.location}
      location={@event.location}
      nonce={assigns[:csp_nonce]}
      heading="Anfahrt"
      class="mt-10"
    />
  </article>
</Layouts.app>
