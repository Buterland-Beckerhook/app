<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-6 text-3xl font-semibold">Verein</h1>

    <nav aria-label="Vereinsseiten" class="grid gap-3 sm:grid-cols-2">
      <a
        :for={p <- @menu_pages}
        href={~p"/verein/#{p.slug}"}
        class="flex items-center justify-between gap-2 rounded-lg border border-base-300 p-4 font-medium transition-colors hover:border-primary hover:text-primary"
      >
        {p.title}
        <span
          :if={p.status != "published"}
          class="rounded bg-warning/15 px-1.5 py-0.5 text-[10px] font-semibold text-warning uppercase"
        >
          Entwurf
        </span>
      </a>
    </nav>

    <p :if={@menu_pages == []} class="text-muted">
      Es sind noch keine Seiten veröffentlicht.
    </p>
  </div>
</Layouts.app>
