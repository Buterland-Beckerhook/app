<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@conn.request_path}>
  <div class="mx-auto max-w-3xl">
    <div
      :if={assigns[:preview]}
      class="mb-4 rounded-box border border-warning bg-warning/10 px-4 py-2 text-sm"
    >
      <span class="font-medium">Vorschau</span>
      — diese Seite ist derzeit nicht öffentlich sichtbar.
    </div>
    <div class="mb-6 flex items-start justify-between gap-3">
      <h1 class="text-3xl font-semibold">{@title}</h1>
      <.edit_link
        :if={Bbh.Authz.can_access_section?(@current_scope && @current_scope.user, :pages)}
        href={~p"/admin/seiten/#{@page.id}/bearbeiten"}
      />
    </div>
    <.blocks blocks={@blocks} />
  </div>
</Layouts.app>
