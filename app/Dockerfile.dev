# Development image for the Phoenix app.
#
# Unlike the production Dockerfile (multi-stage `mix release`), this is a single
# stage that runs `mix phx.server` with the source bind-mounted from the host.
# deps/ and _build/ live in named volumes (see the root compose.yml) so that
# host-compiled (macOS) artifacts never leak into this Linux container.
#
# Keep the Elixir/OTP/Debian versions in sync with the production Dockerfile.

# renovate: datasource=hexpm-bob depName=elixir
ARG ELIXIR_VERSION=1.20.4
# renovate: datasource=hexpm-bob depName=erlang versioning=semver-coerced
ARG OTP_VERSION=29.1.2
# renovate: datasource=docker depName=debian versioning=debian
ARG DEBIAN_VERSION=trixie-20261020-slim

FROM docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}

# build-essential/git for compiling deps; inotify-tools for live code reload;
# postgresql-client for ad-hoc psql; curl for health checks.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       build-essential git inotify-tools postgresql-client curl \
  && rm -rf /var/lib/apt/lists/*

# `pmtiles` CLI for the map archive (Bbh.Workers.MapTilesUpdater, ADR 0014) — keep
# the pin and checksums in sync with the production Dockerfile.
# renovate: datasource=github-releases depName=protomaps/go-pmtiles
ARG PMTILES_VERSION=1.31.2
ARG PMTILES_SHA256_AMD64=3ed7dbf4ec2e6dfe5e25b6f70d1ffc932729f93c86db353bf514dd71010a312f
ARG PMTILES_SHA256_ARM64=f8bd47e7ea866863489cad588fbaf2f31f42e5821f7a03f009b3769f05801cb1
ARG TARGETARCH
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) arch=x86_64; sum="${PMTILES_SHA256_AMD64}" ;; \
      arm64) arch=arm64; sum="${PMTILES_SHA256_ARM64}" ;; \
      *) echo "no pmtiles build for this architecture" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/pmtiles.tar.gz \
       "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/go-pmtiles_${PMTILES_VERSION}_Linux_${arch}.tar.gz" \
  && echo "${sum}  /tmp/pmtiles.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/pmtiles.tar.gz -C /usr/local/bin pmtiles \
  && rm /tmp/pmtiles.tar.gz \
  && pmtiles version

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=dev
# Keep prefetched NIFs (bin/prefetch-precompiled.sh) in the deps volume so they
# survive container rebuilds.
ENV ELIXIR_MAKE_CACHE_DIR=/app/deps/.elixir_make_cache

WORKDIR /app

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
