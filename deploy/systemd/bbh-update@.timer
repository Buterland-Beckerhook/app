# Hourly auto-update of one stack (Beta). Enable with:
#   systemctl enable --now "bbh-update@$(systemd-escape -p /path/to/beta/deploy).timer"
# Output goes to the journal (30-day retention, see journald-bbh.conf):
#   journalctl -u "bbh-update@*" --since today
[Unit]
Description=Hourly update of the bbh stack in %f

[Timer]
OnCalendar=hourly
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
